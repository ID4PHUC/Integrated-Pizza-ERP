<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Sequence cho Yêu cầu mua hàng (PR) -->
        <record id="seq_pizza_procurement" model="ir.sequence">
            <field name="name">Pizza Procurement Request</field>
            <field name="code">pizza.procurement.request</field>
            <field name="prefix">PR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 2. Sequence cho Lệnh sản xuất (MO) -->
        <record id="seq_pizza_production" model="ir.sequence">
            <field name="name">Pizza Production Order</field>
            <field name="code">pizza.production.order</field>
            <field name="prefix">MO-PZ</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 3. Sequence cho Phiếu hủy/Lỗi (Scrap) -->
        <record id="seq_pizza_scrap" model="ir.sequence">
            <field name="name">Pizza Scrap Record</field>
            <field name="code">pizza.scrap.record</field>
            <field name="prefix">SCR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ================================================== -->
        <!-- [MỚI] 4. Sequence cho Đơn bán hàng (Sales Order)   -->
        <!-- ================================================== -->
        <record id="seq_pizza_sales" model="ir.sequence">
            <field name="name">Pizza Sales Order</field>
            <!-- Code này phải khớp với trong file Python: next_by_code('pizza.sales.order') -->
            <field name="code">pizza.sales.order</field> 
            <field name="prefix">SO</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
    </data>
</odoo>