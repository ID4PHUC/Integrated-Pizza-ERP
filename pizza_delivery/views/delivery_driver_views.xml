<odoo>
    <!-- ========================================================= -->
    <!-- PHẦN 1: GIAO DIỆN TÀI XẾ (DRIVER)                         -->
    <!-- ========================================================= -->
    
    <!-- 1. Search View -->
    <record id="view_pizza_driver_search" model="ir.ui.view">
        <field name="name">pizza.driver.search</field>
        <field name="model">pizza.driver</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Tài xế">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="license_plate"/>
                <separator/>
                <filter string="Đang rảnh" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Đang bận" name="busy" domain="[('state', '=', 'busy')]"/>
                <filter string="Nghỉ làm" name="offline" domain="[('state', '=', 'offline')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. List View -->
    <record id="view_pizza_driver_list" model="ir.ui.view">
        <field name="name">pizza.driver.list</field>
        <field name="model">pizza.driver</field>
        <field name="arch" type="xml">
            <list string="Danh sách Tài xế" 
                  decoration-success="state == 'available'" 
                  decoration-warning="state == 'busy'" 
                  decoration-muted="state == 'offline'"
                  sample="1">
                <field name="name"/>
                <field name="partner_id" widget="many2one_avatar_user"/>
                <field name="phone" optional="show"/>
                <field name="vehicle_id" string="Thông tin xe" optional="show"/>
                <field name="license_plate" optional="show"/>
                <field name="delivery_count" string="Số đơn đã giao" sum="Tổng đơn" width="100px"/>
                <field name="rating" widget="priority" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'available'" 
                       decoration-warning="state == 'busy'"
                       decoration-muted="state == 'offline'"/>
            </list>
        </field>
    </record>

    <!-- 3. Form View -->
    <record id="view_pizza_driver_form" model="ir.ui.view">
        <field name="name">pizza.driver.form</field>
        <field name="model">pizza.driver</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ Tài xế">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_pizza_delivery)d" type="action" 
                                class="oe_stat_button" icon="fa-truck" 
                                context="{'search_default_driver_id': id}">
                            <field name="delivery_count" widget="statinfo" string="Đơn hàng"/>
                        </button>
                    </div>
                    
                    <field name="partner_id" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Tên Tài xế"/>
                        <h1><field name="name" placeholder="Nhập tên tài xế..."/></h1>
                    </div>
                    <group>
                        <group string="Thông tin cá nhân">
                            <field name="partner_id" widget="res_partner_many2one"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group string="Phương tiện &amp; Đánh giá">
                            <field name="vehicle_id"/>
                            <field name="license_plate"/>
                            <field name="rating" widget="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử nghỉ phép">
                            <field name="leave_request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="reason"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 4. Action Driver -->
    <record id="action_pizza_driver" model="ir.actions.act_window">
        <field name="name">Danh sách Tài xế</field>
        <field name="res_model">pizza.driver</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có tài xế nào!</p>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- PHẦN 2: GIAO DIỆN XIN NGHỈ (LEAVE REQUEST)                -->
    <!-- ========================================================= -->
    
    <!-- 1. Form View -->
    <record id="view_pizza_driver_leave_form" model="ir.ui.view">
        <field name="name">pizza.driver.leave.request.form</field>
        <field name="model">pizza.driver.leave.request</field>
        <field name="arch" type="xml">
            <form string="Phiếu xin nghỉ">
                <header>
                    <button name="action_confirm" string="Gửi duyệt" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    
                    <!-- Nút Duyệt: Chỉ Manager thấy (Dùng nhóm manager của) -->
                    <button name="action_approve" string="Phê duyệt" type="object" class="btn-success" 
                            invisible="state != 'confirm'" 
                            groups="pizza_delivery.group_pizza_delivery_manager"/>
                            
                    <button name="action_refuse" string="Từ chối" type="object" class="btn-danger" 
                            invisible="state != 'confirm'" 
                            groups="pizza_delivery.group_pizza_delivery_manager"/>
                            
                    <button name="action_draft" string="Reset" type="object" invisible="state not in ('confirm', 'cancel')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="driver_id" options="{'no_create': True}"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 2. List View -->
    <record id="view_pizza_driver_leave_list" model="ir.ui.view">
        <field name="name">pizza.driver.leave.request.list</field>
        <field name="model">pizza.driver.leave.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" 
                  decoration-warning="state == 'confirm'" 
                  decoration-success="state == 'approved'" 
                  decoration-muted="state == 'refused'">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="date_from" width="100px"/>
                <field name="date_to"/>
                <field name="reason"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'confirm'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- 3. Action Leave -->
    <record id="action_pizza_driver_leave" model="ir.actions.act_window">
        <field name="name">Yêu cầu nghỉ phép</field>
        <field name="res_model">pizza.driver.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
             <p class="o_view_nocontent_smiling_face">Tạo yêu cầu nghỉ phép mới!</p>
        </field>
    </record>

    <!-- 4. Menu Item (Giả sử menu cha là menu_pizza_delivery_root hoặc tương tự) -->
     <menuitem id="menu_pizza_driver_leave"
              name="Xin nghỉ phép"
              parent="menu_delivery_config" 
              action="action_pizza_driver_leave"
              sequence="20"/>
</odoo>